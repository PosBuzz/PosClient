# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
# Server
PORT=8000
NODE_ENV=development

# Database Connection String
DB_HOST=127.0.0.1
DB_NAME=posbuzz
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_PORT=5432
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=posbuzz

CACHE_TTL=3600

# JWT
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=REDACTED_SECRET 
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# FastAPI Service
FASTAPI_URL=http://localhost:8001/api/v1

# PostgreSQL Binaries
PG_DUMP_PATH=C:\Users\istia\AppData\Local\com.tinyapp.DBngin\Binaries\postgresql\17.0\bin\pg_dump.exe
PSQL_PATH=C:\Users\istia\AppData\Local\com.tinyapp.DBngin\Binaries\postgresql\17.0\bin\psql.exe