# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
# Server
PORT=8000
NODE_ENV=development
# Time zone for business days (reports, sale numbers). Defaults to Asia/Dhaka.
BUSINESS_TIMEZONE=Asia/Dhaka

# Database Connection String
DB_HOST=127.0.0.1
DB_NAME=posbuzz
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_PORT=5432
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# Redis cache (optional, not part of any compose file). Off unless REDIS_ENABLED=true and a Redis is reachable.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=posbuzz

CACHE_TTL=3600

# JWT
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=655a41e13d92ebe879e8fae73a575c1e25eb8cc1e4ddf78f6a19f91cdfb78 
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

CSRF_SECRET_KEY=51c2be361566806a9a224805e32ed647

# CORS
# For multi-tenant subdomains, use wildcard patterns like https://*.example.com
# Separate multiple origins with commas
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173,https://*.example.com,https://*.posbuzz.com,http://*.localhost:3000,http://*.localhost:5173,http://*.localhost:3001

# RabbitMQ (optional, AI description queue). Off unless RABBITMQ_ENABLED=true; docker-compose.with-ai.yml
# runs RabbitMQ and sets it to true. When off, AI descriptions go straight to FASTAPI_URL over HTTP.
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# FastAPI Service
FASTAPI_URL=http://localhost:8001/api/v1

# PostgreSQL Binaries
PG_DUMP_PATH=C:\Users\istia\AppData\Local\com.tinyapp.DBngin\Binaries\postgresql\17.0\bin\pg_dump.exe
PSQL_PATH=C:\Users\istia\AppData\Local\com.tinyapp.DBngin\Binaries\postgresql\17.0\bin\psql.exe

# Portfolio publish hook (optional). When unset, the marketing site refreshes
# on its own ISR schedule instead of publishing CMS edits immediately.
# Secret must match REVALIDATE_SECRET in the portfolio app.
PORTFOLIO_REVALIDATE_URL=http://localhost:3002/api/revalidate
PORTFOLIO_REVALIDATE_SECRET=
