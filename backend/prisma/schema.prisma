generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum TaxMethod {
  INCLUSIVE
  EXCLUSIVE
}

enum PaymentMethodEnum {
  CASH
  CARD
  CHEQUE
  BANK_TRANSFER
  MOBILE_MONEY
  MFS
  CREDIT
  EXCHANGE
}

