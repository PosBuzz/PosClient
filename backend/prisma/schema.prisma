  BANGLADESH_BANK
  SONALI_BANK_LIMITED
  JANATA_BANK_LIMITED
  AGRANI_BANK_LIMITED
  RUPALI_BANK_LIMITED
  BANGLADESH_KRISHI_BANK
  RAJSHAHI_KRISHI_UNNAYAN_BANK
  BANGLADESH_DEVELOPMENT_BANK_LIMITED
  BASIC_BANK_LIMITED
  ANSAR_VDP_UNNAYAN_BANK
  KARMASANGSTHAN_BANK
  AB_BANK_LIMITED
  AL_ARAFAH_ISLAMI_BANK_LIMITED
  BANGLADESH_COMMERCE_BANK_LIMITED
  BANK_ASIA_LIMITED
  BRAC_BANK_LIMITED
  DHAKA_BANK_LIMITED
  DUTCH_BANGLA_BANK_LIMITED
  EASTERN_BANK_LIMITED
  EXIM_BANK_LIMITED
  FIRST_SECURITY_ISLAMI_BANK_LIMITED
  ICB_ISLAMIC_BANK_LIMITED
  IFIC_BANK_LIMITED
  ISLAMI_BANK_BANGLADESH_LIMITED
  JAMUNA_BANK_LIMITED
  MEGHNA_BANK_LIMITED
  MERCANTILE_BANK_LIMITED
  MIDLAND_BANK_LIMITED
  MUTUAL_TRUST_BANK_LIMITED
  NATIONAL_BANK_LIMITED
  NRB_BANK_LIMITED
  NATIONAL_CREDIT_AND_COMMERCE_BANK_LIMITED
  NRB_COMMERCIAL_BANK_LIMITED
  ONE_BANK_LIMITED
  PREMIER_BANK_LIMITED
  PRIME_BANK_LIMITED
  PUBALI_BANK_LIMITED
  SHAHJALAL_ISLAMI_BANK_LIMITED
  SOCIAL_ISLAMI_BANK_LIMITED
  SOUTH_BANGLA_AGRICULTURE_AND_COMMERCE_BANK_LIMITED
  SOUTHEAST_BANK_LIMITED
  STANDARD_BANK_LIMITED
  THE_CITY_BANK_LIMITED
  THE_FARMERS_BANK_LIMITED
  TRUST_BANK_LIMITED
  UNION_BANK_LIMITED
  UNITED_COMMERCIAL_BANK_LIMITED
  UTTARA_BANK_LIMITED
  BANK_AL_FALAH_LIMITED
  CITIBANK_N_A
  COMMERCIAL_BANK_OF_CEYLON_LIMITED
  HABIB_BANK_LIMITED
  NATIONAL_BANK_OF_PAKISTAN
  STANDARD_CHARTERED_BANK
  STATE_BANK_OF_INDIA
  THE_HONGKONG_AND_SHANGHAI_BANKING_CORPORATION_LTD
  WOORI_BANK
  ROCKET
  BKASH
  MYCASH
  ISLAMI_BANK_MCASH
  TRUST_AXIATA_PAY_TAP
  FIRSTCASH
  UPAY
  OK_WALLET
  RUPALI_BANK
  TELECASH
  ISLAMIC_WALLET
  MEGHNA_PAY
  NAGAD
}

enum OnlineOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  RESIGNED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  PARTIALLY_PAID
}

enum DeductionStatus {
  PENDING
  APPLIED
  PARTIALLY_APPLIED
  CANCELLED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  DEDUCTED
  PARTIALLY_DEDUCTED
}

enum RewardsTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUSTMENT
}

// New enum for audit log
enum InventoryEventType {
  PURCHASE_IN // New InventoryBatch created via purchase
  SALE_OUT // Stock deducted via SaleItem
  RETURN_IN // Stock restocked via ReturnItem
  TRANSFER_OUT // Stock left source branch
  TRANSFER_IN // Stock arrived at destination branch
  ADJUSTMENT // Manual InventoryAdjustment
  EXCHANGE_OUT // Stock given out via ReturnExchange
  SALE_DELETE_IN // Stock restocked because a sale was soft-deleted
  SALE_RESTORE_OUT // Stock deducted again because a deleted sale was restored
}

// ============================================
// Super Admin
// ============================================

model SuperAdmin {
  id                Int            @id @default(autoincrement())
  role_id           Int
  email             String         @unique
  name              String
  password          String
  refresh_token     String?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  created_by_id     Int?
  created_by        SuperAdmin?    @relation("CreatedBy", fields: [created_by_id], references: [id])
  created           SuperAdmin[]   @relation("CreatedBy")
  role              SuperAdminRole @relation(fields: [role_id], references: [id], onDelete: Cascade)
  deleted_consumers Consumer[]     @relation("ConsumerDeletedBy")

  assigned_support_tickets SupportTicket[]        @relation("SupportTicketAssignee")
  support_ticket_messages  SupportTicketMessage[] @relation("SupportMessageAdminAuthor")

  @@index([role_id])
  @@map("super_admins")
}

model SuperAdminRole {
  id          Int                        @id @default(autoincrement())
  name        String                     @unique
  permissions SuperAdminRolePermission[]
  users       SuperAdmin[]

  @@map("super_admin_roles")
}

model SuperAdminPermission {
  id             Int                        @id @default(autoincrement())
  action         String                     @unique
  RolePermission SuperAdminRolePermission[]

  @@map("super_admin_permissions")
}

model SuperAdminRolePermission {
  role_id       Int
  permission_id Int
  role          SuperAdminRole       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    SuperAdminPermission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@map("super_admin_role_permissions")
}

// ============================================
// Consumer (Tenant)
// ============================================

model Consumer {
  id                Int      @id @default(autoincrement())
  company_name      String
  business_category String?
  secondary_email   String?
  logo              String?
  max_branch        Int      @default(1)
  email             String
  phone             String?
  address           String?
  subdomain         String   @unique
  plan_id           Int
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Soft delete (superadmin). Subdomain stays reserved while deleted_at is set.
  deleted_at    DateTime?
  deleted_by_id Int?
  delete_reason String?

  plan                     Plan                      @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  deleted_by               SuperAdmin?               @relation("ConsumerDeletedBy", fields: [deleted_by_id], references: [id], onDelete: SetNull)
  users                    User[]
  roles                    Role[]
  billing_logs             BillingHistory[]
  Product                  Product[]
  Tag                      Tag[]
  Unit                     Unit[]
  Category                 Category[]
  Brand                    Brand[]
  Branch                   Branch[]
  Vendor                   Vendor[]
  VariantAttribute         VariantAttribute[]
  Promotion                Promotion[]
  Customer                 Customer[]
  Sales                    Sale[]
  Returns                  Return[]
  RewardsSettings          RewardsSettings?
  CustomerRewardsPoints    CustomerRewardsPoints[]
  RewardsPointTransactions RewardsPointTransaction[]
  inventory_audit_logs     InventoryAuditLog[]

  // ERP
  erp_settings       ERPSettings?
  salary_structures  SalaryStructure[]
  attendances        Attendance[]
  leaves             Leave[]
  overtimes          Overtime[]
  expenses           Expense[]
  deductions         Deduction[]
  advances           Advance[]
  salary_increments  SalaryIncrement[]
  salary_payments    SalaryPayment[]
  receiptPdfSettings ReceiptPdfSetting[]
  operational_costs  OperationalCost[]
  support_tickets    SupportTicket[]

  @@index([email])
  @@index([plan_id])
  @@index([deleted_at]) // Active vs. soft-deleted consumer listing
  @@map("consumers")
}

// ============================================
// Plans & Billing
// ============================================

model Plan {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  price          Float
  max_products   Int? // Null = unlimited products for consumers on this plan
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  consumers      Consumer[]
  permissions    PlanPermission[]
  BillingHistory BillingHistory[]

  @@map("plans")
}

model PlanPermission {
  plan_id       Int
  permission_id Int
  plan          Plan       @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([plan_id, permission_id])
  @@index([permission_id])
  @@map("plan_permissions")
}

model BillingHistory {
  id           Int      @id @default(autoincrement())
  consumer_id  Int
  plan_id      Int
  amount       Float
  reference    String?
  billing_date DateTime
  billing_from DateTime
  billing_till DateTime
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  consumer Consumer @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [plan_id], references: [id], onDelete: Restrict)

  @@unique([consumer_id, billing_date])
  @@index([billing_date])
  @@index([consumer_id, billing_from, billing_till])
  @@index([billing_till])
  @@map("billing_histories")
}

// ============================================
// Users & Roles
// ============================================

model User {
  id            Int     @id @default(autoincrement())
  consumer_id   Int
  role_id       Int
  email         String
  name          String
  password      String
  refresh_token String?

  employee_id       String?           @unique
  phone             String?
  address           String?
  date_of_birth     DateTime?
  date_of_joining   DateTime?
  employment_status EmploymentStatus? @default(ACTIVE)
  nid_number        String?
  photo_url         String?
  cv_url            String?
  nid_document_url  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  consumer Consumer     @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  role     Role         @relation("UserRole", fields: [role_id], references: [id], onDelete: Cascade)
  branches UserBranch[]

  InventoryTransfer            InventoryTransfer[]
  InventoryAdjustment          InventoryAdjustment[]
  PriceHistory                 PriceHistory[]
  promotions                   Promotion[]
  Sales                        Sale[]
  served_by_sales              Sale[]                    @relation("ServedBy")
  deleted_sales                Sale[]                    @relation("SaleDeletedBy")
  Returns                      Return[]
  created_rewards_transactions RewardsPointTransaction[]
  inventory_audit_logs         InventoryAuditLog[]

  // ERP
  salary_structures         SalaryStructure[]
  attendances               Attendance[]
  leaves                    Leave[]             @relation("EmployeeLeaves")
  approved_leaves           Leave[]             @relation("LeaveApprover")
  overtimes                 Overtime[]          @relation("EmployeeOvertimes")
  approved_overtimes        Overtime[]          @relation("OvertimeApprover")
  expenses                  Expense[]           @relation("EmployeeExpenses")
  approved_expenses         Expense[]           @relation("ExpenseApprover")
  deductions                Deduction[]
  advances                  Advance[]           @relation("EmployeeAdvances")
  approved_advances         Advance[]           @relation("AdvanceApprover")
  salary_increments         SalaryIncrement[]   @relation("EmployeeSalaryIncrements")
  salary_increments_created SalaryIncrement[]   @relation("SalaryIncrementCreator")
  salary_payments           SalaryPayment[]
  receiptPdfSettings        ReceiptPdfSetting[]
  operational_costs         OperationalCost[]

  support_tickets         SupportTicket[]        @relation("SupportTicketCreator")
  support_ticket_messages SupportTicketMessage[] @relation("SupportMessageConsumerAuthor")

  @@unique([consumer_id, email])
  @@index([role_id])
  @@index([employee_id])
  @@index([employment_status])
  @@index([consumer_id, employment_status]) // Main query: active employees per tenant
  @@map("users")
}

model Permission {
  id             Int              @id @default(autoincrement())
  action         String           @unique
  RolePermission RolePermission[]
  PlanPermission PlanPermission[]

  @@map("permissions")
}

model Role {
  id                 Int     @id @default(autoincrement())
  name               String
  is_admin           Boolean @default(false)
  hierarchy_level    Int     @default(0)
  reports_to_role_id Int?
  consumer_id        Int

  consumer          Consumer         @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  reports_to        Role?            @relation("RoleHierarchy", fields: [reports_to_role_id], references: [id], onDelete: SetNull)
  subordinate_roles Role[]           @relation("RoleHierarchy")
  permissions       RolePermission[]
  users             User[]           @relation("UserRole")

  @@unique([consumer_id, name])
  @@index([reports_to_role_id])
  // hierarchy_level standalone index dropped — always queried within a consumer
  @@map("roles")
}

model RolePermission {
  role_id       Int
  permission_id Int
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@map("role_permissions")
}

// ============================================
// Products
// ============================================

model Product {
  id           Int            @id @default(autoincrement())
  consumer_id  Int
  name         String
  code         String?
  description  String?
  category_id  Int?
  brand_id     Int?
  tags         TagOnProduct[]
  has_variants Boolean        @default(false)
  tax_method   TaxMethod      @default(EXCLUSIVE)
  tax          Int            @default(0)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  consumer Consumer         @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [category_id], references: [id], onDelete: SetNull)
  brand    Brand?           @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  variants ProductVariant[]

  @@unique([consumer_id, name])
  @@unique([consumer_id, code])
  @@index([consumer_id, category_id]) // Products filtered by category within a tenant
  @@index([consumer_id, brand_id]) // Products filtered by brand within a tenant
  @@map("products")
}

model ProductVariant {
  id                   Int      @id @default(autoincrement())
  product_id           Int
  name                 String
  sku                  String?
  barcode              String?
  regular_price        Decimal  @db.Decimal(10, 2)
  wholesale_price      Decimal? @db.Decimal(10, 2)
  sale_unit_id         Int
  purchase_unit_id     Int
  warranty_period      Int?
  image                String?
  is_default           Boolean  @default(false)
  alert_quantity       Int?     @default(0)
  daily_sale_objective Int?     @default(0)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  product              Product               @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sale_unit            Unit                  @relation("SaleUnit", fields: [sale_unit_id], references: [id], onDelete: Restrict)
  purchase_unit        Unit                  @relation("PurchaseUnit", fields: [purchase_unit_id], references: [id], onDelete: Restrict)
  inventory_items      InventoryBatch[]
  price_history        PriceHistory[]
  promotions           PromotionProduct[]
  VariantAttribute     VariantAttribute[]
  serials              ProductSerial[]
  InventoryAdjustment  InventoryAdjustment[]
  SaleItems            SaleItem[]
  ReturnItems          ReturnItem[]
  ReturnExchanges      ReturnExchange[]
  inventory_audit_logs InventoryAuditLog[]

  @@index([product_id, name])
  @@index([sku])
  @@index([barcode])
  @@map("product_variants")
}

model ProductSerial {
  id            Int       @id @default(autoincrement())
  variant_id    Int
  serial_number String
  status        String    @default("available")
  batch_id      Int?
  sold_date     DateTime?
  notes         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  variant ProductVariant  @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  batch   InventoryBatch? @relation(fields: [batch_id], references: [id], onDelete: SetNull)

  @@unique([variant_id, serial_number])
  @@index([variant_id, status])
  @@index([serial_number])
  @@map("product_serials")
}

// ============================================
// Catalogue helpers
// ============================================

model Unit {
  id          Int      @id @default(autoincrement())
  consumer_id Int
  name        String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  consumer          Consumer         @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  sale_variants     ProductVariant[] @relation("SaleUnit")
  purchase_variants ProductVariant[] @relation("PurchaseUnit")

  @@unique([consumer_id, name])
  @@map("units")
}

model Category {
  id          Int      @id @default(autoincrement())
  consumer_id Int
  name        String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  consumer Consumer  @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([consumer_id, name])
  @@map("categories")
}

model Brand {
  id          Int      @id @default(autoincrement())
  consumer_id Int
  name        String
  logo        String?
  website     String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  consumer   Consumer    @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  products   Product[]
  promotions Promotion[]

  @@unique([consumer_id, name])
  @@map("brands")
}

model Tag {
  id          Int      @id @default(autoincrement())
  consumer_id Int
  name        String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  consumer Consumer       @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  products TagOnProduct[]

  @@unique([consumer_id, name])
  @@map("tags")
}

model TagOnProduct {
  product_id Int
  tag_id     Int
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  tag        Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([product_id, tag_id])
  @@index([tag_id])
  @@map("tag_on_products")
}

model VariantAttribute {
  id          Int    @id @default(autoincrement())
  variant_id  Int
  consumer_id Int
  name        String
  value       String

  variant  ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  consumer Consumer       @relation(fields: [consumer_id], references: [id], onDelete: Cascade)

  @@unique([variant_id, name])
  @@index([consumer_id, name])
}

// ============================================
// Branches & Users
// ============================================

model Branch {
  id                      Int      @id @default(autoincrement())
  consumer_id             Int
  name                    String
  address                 String?
  email                   String?
  phone                   String?
  vat_registration_number String?
  is_main                 Boolean  @default(false)
  is_warehouse            Boolean  @default(false)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  consumer             Consumer              @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  users                UserBranch[]
  inventory            InventoryBatch[]
  transfers_from       InventoryTransfer[]   @relation("SourceBranch")
  transfers_to         InventoryTransfer[]   @relation("DestinationBranch")
  PromotionBranch      PromotionBranch[]
  InventoryAdjustment  InventoryAdjustment[]
  Sales                Sale[]
  Returns              Return[]
  inventory_audit_logs InventoryAuditLog[]
  receiptPdfSettings   ReceiptPdfSetting[]
  operational_costs    OperationalCost[]

  @@unique([consumer_id, name])
  @@map("branches")
}

model UserBranch {
  user_id   Int
  branch_id Int
  user      User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch    Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@id([user_id, branch_id])
  @@index([branch_id])
  @@map("user_branches")
}

// ============================================
// Inventory
// ============================================

model InventoryBatch {
  id                Int       @id @default(autoincrement())
  variant_id        Int
  branch_id         Int
  batch_number      String
  quantity          Int
  reserved_quantity Int       @default(0)
  // REMOVED: original_quantity — derive from PURCHASE_IN audit log row
  // REMOVED: source            — derive from event_type in audit log
  cost_price        Decimal   @db.Decimal(10, 2)
  vendor_id         Int?
  // Where the stock physically sits, e.g. "A-3-2" or "Cold Room, Rack 4"
  location          String?
  expiry_date       DateTime?
  payment_status    String    @default("paid") // paid | partial | due
  paid_amount       Decimal   @default(0) @db.Decimal(10, 2)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  variant              ProductVariant          @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  branch               Branch                  @relation(fields: [branch_id], references: [id])
  vendor               Vendor?                 @relation(fields: [vendor_id], references: [id], onDelete: SetNull)
  transfers            InventoryTransferItem[]
  InventoryAdjustment  InventoryAdjustment[]
  serials              ProductSerial[]
  SaleItems            SaleItem[]
  ReturnItems          ReturnItem[]
  ReturnExchanges      ReturnExchange[]
  inventory_audit_logs InventoryAuditLog[]
  purchasePayments     PurchasePayment[]

  @@index([variant_id, branch_id, quantity])
  @@index([vendor_id])
  @@index([expiry_date])
  @@index([batch_number])
  @@index([location])
  @@index([created_at])
  @@index([payment_status])
  @@map("inventory_batches")
}

model PurchasePayment {
  id             Int               @id @default(autoincrement())
  batch_id       Int
  payment_method PaymentMethodEnum
  payment_type   PaymentTypeEnum?
  amount         Decimal           @db.Decimal(10, 2)
  reference      String?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  batch InventoryBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@index([batch_id])
  @@index([payment_method])
  @@map("purchase_payments")
}

model InventoryTransfer {
  id                    Int       @id @default(autoincrement())
  source_branch_id      Int
  destination_branch_id Int
  status                String    @default("pending")
  notes                 String?
  created_by_user_id    Int
  created_at            DateTime  @default(now())
  completed_date        DateTime?
  updated_at            DateTime  @updatedAt

  source_branch      Branch                  @relation("SourceBranch", fields: [source_branch_id], references: [id])
  destination_branch Branch                  @relation("DestinationBranch", fields: [destination_branch_id], references: [id])
  created_by_user    User                    @relation(fields: [created_by_user_id], references: [id])
  items              InventoryTransferItem[]

  @@index([source_branch_id, created_at])
  @@index([destination_branch_id, created_at])
  @@index([created_by_user_id])
  @@index([status, created_at])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id            Int  @id @default(autoincrement())
  transfer_id   Int
  batch_id      Int
  quantity      Int
  dest_batch_id Int?

  transfer InventoryTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  batch    InventoryBatch    @relation(fields: [batch_id], references: [id])

  @@index([transfer_id, batch_id])
  @@index([dest_batch_id])
  @@map("inventory_transfer_items")
}

model InventoryAdjustment {
  id                 Int      @id @default(autoincrement())
  variant_id         Int
  branch_id          Int
  batch_id           Int
  quantity_change    Int
  adjustment_type    String   @default("manual")
  reason             String
  notes              String?
  created_by_user_id Int?
  created_at         DateTime @default(now())

  variant         ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  batch           InventoryBatch @relation(fields: [batch_id], references: [id])
  branch          Branch         @relation(fields: [branch_id], references: [id])
  created_by_user User?          @relation(fields: [created_by_user_id], references: [id], onDelete: SetNull)

  @@index([variant_id, branch_id])
  @@index([batch_id])
  @@index([created_at])
  @@map("inventory_adjustments")
}

// ============================================
// Inventory Audit Log (NEW)
// ============================================

model InventoryAuditLog {
  id          Int  @id @default(autoincrement())
  consumer_id Int
  branch_id   Int
  variant_id  Int
  batch_id    Int? // Null only on TRANSFER_OUT before dest batch is created

  event_type     InventoryEventType
  quantity_delta Int // Negative = stock left, positive = stock arrived
  quantity_after Int // Snapshot of batch.quantity AFTER the change

  // Polymorphic back-reference to the source row
  // e.g. reference_type = "sale_items", reference_id = 42
  reference_id   Int?
  reference_type String? // sale_items | return_items | inventory_transfer_items | inventory_adjustments | inventory_batches | return_exchanges

  notes              String?
  created_by_user_id Int?
  created_at         DateTime @default(now())

  consumer         Consumer        @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  branch           Branch          @relation(fields: [branch_id], references: [id])
  variant          ProductVariant  @relation(fields: [variant_id], references: [id])
  created_by       User?           @relation(fields: [created_by_user_id], references: [id], onDelete: SetNull)
  inventoryBatch   InventoryBatch? @relation(fields: [inventoryBatchId], references: [id])
  inventoryBatchId Int?

  @@index([variant_id, branch_id]) // "Full history of variant X at branch Y"
  @@index([batch_id]) // "Full history of a single batch"
  @@index([consumer_id, created_at]) // "All movements for tenant over period"
  @@index([event_type, created_at]) // "All sales/returns in date range"
  @@index([reference_type, reference_id]) // Reverse lookup to source row
  @@map("inventory_audit_logs")
}

// ============================================
// Vendor
// ============================================

model Vendor {
  id          Int      @id @default(autoincrement())
  consumer_id Int
  name        String
  contact     String?
  phone       String?
  email       String?
  address     String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  consumer Consumer         @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  batches  InventoryBatch[]

  @@unique([consumer_id, name])
  @@index([consumer_id, email])
  @@map("vendors")
}

// ============================================
// Pricing
// ============================================

model PriceHistory {
  id                 Int      @id @default(autoincrement())
  variant_id         Int
  regular_price      Decimal  @db.Decimal(10, 2)
  wholesale_price    Decimal? @db.Decimal(10, 2)
  effective_date     DateTime @default(now())
  created_by_user_id Int?

  variant         ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  created_by_user User?          @relation(fields: [created_by_user_id], references: [id], onDelete: SetNull)

  @@index([variant_id, effective_date])
  @@map("price_history")
}

// ============================================
// Promotions
// ============================================

model Promotion {
  id                         Int       @id @default(autoincrement())
  consumer_id                Int
  created_by_user_id         Int?
  name                       String
  description                String?
  scope                      String    @default("SINGLE_PRODUCT")
  discount_type              String
  discount_value             Decimal   @db.Decimal(10, 2)
  start_date                 DateTime
  end_date                   DateTime?
  is_active                  Boolean   @default(true)
  brand_id                   Int?
  min_quantity               Int?      @default(1)
  usage_limit                Int?
  cap_quantity               Int?
  min_purchase               Decimal?  @db.Decimal(10, 2)
  max_discount_amount        Decimal?  @db.Decimal(10, 2)
  cap_discount_amount        Decimal?  @db.Decimal(10, 2)
  member_only                Boolean   @default(false)
  limit_per_customer         Boolean   @default(false)
  customer_usage_limit       Int?
  customer_usage_daily_reset Boolean   @default(false)
  auto_apply                 Boolean   @default(false)
  branch_specific            Boolean   @default(false)
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  consumer        Consumer           @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  created_by_user User?              @relation(fields: [created_by_user_id], references: [id], onDelete: SetNull)
  brand           Brand?             @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  products        PromotionProduct[]
  branches        PromotionBranch[]
  sales           Sale[]

  @@index([consumer_id, is_active, start_date, end_date])
  @@index([brand_id])
  @@map("promotions")
}

model PromotionProduct {
  promotion_id Int
  variant_id   Int
  promotion    Promotion      @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@id([promotion_id, variant_id])
  @@index([variant_id])
  @@map("promotion_products")
}

model PromotionBranch {
  promotion_id Int
  branch_id    Int
  promotion    Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  branch       Branch    @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@id([promotion_id, branch_id])
  @@index([branch_id])
  @@map("promotion_branches")
}

// ============================================
// Customers
// ============================================

model Customer {
  id            Int       @id @default(autoincrement())
  consumer_id   Int
  name          String
  email         String?
  phone         String    @unique
  address       String?
  // Date only; the time part is never meaningful here
  birthday      DateTime? @db.Date
  customer_type String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  consumer           Consumer                  @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  Sales              Sale[]
  rewards_points     CustomerRewardsPoints?
  point_transactions RewardsPointTransaction[]

  @@index([consumer_id, name]) // Customer search within tenant
  @@index([consumer_id, email]) // Email lookup within tenant
  // phone has @unique — already indexed
  @@map("customers")
}

// ============================================
// Sales
// ============================================

model Sale {
  id                   Int       @id @default(autoincrement())
  sale_number          String
  consumer_id          Int
  customer_id          Int?
  customer_name        String?
  customer_phone       String?
  customer_email       String?
  promotion_id         Int?
  branch_id            Int
  user_id              Int?
  served_by_id         Int?
  sale_date            DateTime  @default(now())
  sale_type            String    @default("sale")
  price_type           String    @default("regular")
  subtotal             Decimal   @db.Decimal(10, 2)
  discount_amount      Decimal   @default(0) @db.Decimal(10, 2)
  promotion_discount   Decimal   @default(0) @db.Decimal(10, 2)
  shipping_cost        Decimal   @default(0) @db.Decimal(10, 2)
  tax_amount           Decimal   @default(0) @db.Decimal(10, 2)
  total_amount         Decimal   @db.Decimal(10, 2)
  payment_status       String    @default("paid")
  received_amount      Decimal   @default(0) @db.Decimal(10, 2)
  // REMOVED: change_amount — always computed as (received_amount - total_amount) at read time
  notes                String?
  converted_to_sale_id Int?
  converted_at         DateTime?
  is_online_order      Boolean   @default(false)
  online_order_status  String?   @default("PENDING")
  is_delivery_later    Boolean   @default(false)
  delivery_status      String?
  delivered_at         DateTime?
  deleted_at           DateTime?
  deleted_by_id        Int?
  delete_reason        String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  consumer                   Consumer                  @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  customer                   Customer?                 @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  promotion                  Promotion?                @relation(fields: [promotion_id], references: [id], onDelete: SetNull)
  branch                     Branch                    @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  user                       User?                     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  served_by                  User?                     @relation("ServedBy", fields: [served_by_id], references: [id], onDelete: SetNull)
  deleted_by                 User?                     @relation("SaleDeletedBy", fields: [deleted_by_id], references: [id], onDelete: SetNull)
  items                      SaleItem[]
  payments                   SalePayment[]
  returns_as_original        Return[]                  @relation("OriginalSale")
  returns_as_exchange        Return[]                  @relation("ExchangeSale")
  rewards_point_transactions RewardsPointTransaction[]
  converted_to_sale          Sale?                     @relation("QuotationConversion", fields: [converted_to_sale_id], references: [id], onDelete: SetNull)
  converted_from_quotations  Sale[]                    @relation("QuotationConversion")

  @@unique([sale_number, consumer_id])
  @@index([consumer_id, sale_date]) // Sales report for tenant over period — primary query
  @@index([consumer_id, branch_id, sale_date]) // Branch-level sales report
  @@index([customer_id])
  @@index([payment_status])
  @@index([converted_to_sale_id])
  @@index([is_online_order, online_order_status]) // Online order management view
  @@index([consumer_id, deleted_at]) // Active vs. soft-deleted sales listing
  @@index([consumer_id, is_delivery_later, delivery_status])
  // sale_type standalone index dropped — always queried scoped to consumer/branch
  @@map("sales")
}

model SaleItem {
  id                        Int      @id @default(autoincrement())
  sale_id                   Int
  variant_id                Int
  batch_id                  Int?
  quantity                  Int
  unit_price                Decimal  @db.Decimal(10, 2)
  sold_unit_price           Decimal? @db.Decimal(10, 2)
  average_discount_amount   Decimal  @default(0) @db.Decimal(10, 2)
  special_discount_amount   Decimal  @default(0) @db.Decimal(10, 2)
  promotion_discount_amount Decimal  @default(0) @db.Decimal(10, 2)
  applied_promotion_id      Int?
  tax_amount                Decimal  @default(0) @db.Decimal(10, 2)
  line_total                Decimal  @db.Decimal(10, 2)

  sale         Sale            @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  variant      ProductVariant  @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  batch        InventoryBatch? @relation(fields: [batch_id], references: [id], onDelete: SetNull)
  return_items ReturnItem[]

  @@index([sale_id])
  @@index([variant_id])
  @@index([batch_id])
  @@map("sale_items")
}

model SalePayment {
  id             Int               @id @default(autoincrement())
  sale_id        Int
  payment_method PaymentMethodEnum
  payment_type   PaymentTypeEnum?
  amount         Decimal           @db.Decimal(10, 2)
  reference      String?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  sale Sale @relation(fields: [sale_id], references: [id], onDelete: Cascade)

  @@index([sale_id])
  @@index([payment_method]) // Payment method breakdown reports
  @@map("sale_payments")
}

// ============================================
// Returns
// ============================================

model Return {
  id               Int      @id @default(autoincrement())
  return_number    String
  original_sale_id Int
  exchange_sale_id Int?
  consumer_id      Int
  branch_id        Int
  user_id          Int?
  return_date      DateTime @default(now())
  total_refund     Decimal  @default(0) @db.Decimal(10, 2)
  total_exchange   Decimal  @default(0) @db.Decimal(10, 2)
  reason           String?
  notes            String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  original_sale Sale             @relation("OriginalSale", fields: [original_sale_id], references: [id], onDelete: Restrict)
  exchange_sale Sale?            @relation("ExchangeSale", fields: [exchange_sale_id], references: [id], onDelete: SetNull)
  consumer      Consumer         @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  branch        Branch           @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  user          User?            @relation(fields: [user_id], references: [id], onDelete: SetNull)
  items         ReturnItem[]
  payments      ReturnPayment[]
  exchanges     ReturnExchange[]

  @@unique([return_number, consumer_id])
  @@index([original_sale_id])
  @@index([consumer_id, return_date])
  @@index([branch_id])
  @@map("returns")
}

model ReturnItem {
  id           Int  @id @default(autoincrement())
  return_id    Int
  sale_item_id Int
  variant_id   Int
  batch_id     Int?
  quantity     Int

  return_record Return          @relation(fields: [return_id], references: [id], onDelete: Cascade)
  sale_item     SaleItem        @relation(fields: [sale_item_id], references: [id], onDelete: Restrict)
  variant       ProductVariant  @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  batch         InventoryBatch? @relation(fields: [batch_id], references: [id], onDelete: SetNull)

  @@index([return_id])
  @@index([sale_item_id])
  @@index([variant_id])
  @@map("return_items")
}

model ReturnPayment {
  id             Int               @id @default(autoincrement())
  return_id      Int
  payment_method PaymentMethodEnum
  payment_type   PaymentTypeEnum?
  amount         Decimal           @db.Decimal(10, 2)
  reference      String?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  return_record Return @relation(fields: [return_id], references: [id], onDelete: Cascade)

  @@index([return_id])
  @@map("return_payments")
}

model ReturnExchange {
  id         Int     @id @default(autoincrement())
  return_id  Int
  variant_id Int
  batch_id   Int?
  quantity   Int
  unit_price Decimal @db.Decimal(10, 2)
  line_total Decimal @db.Decimal(10, 2)

  return_record Return          @relation(fields: [return_id], references: [id], onDelete: Cascade)
  variant       ProductVariant  @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  batch         InventoryBatch? @relation(fields: [batch_id], references: [id], onDelete: SetNull)

  @@index([return_id])
  @@index([variant_id])
  @@map("return_exchanges")
}

// ============================================
// Rewards
// ============================================

model RewardsSettings {
  id          Int     @id @default(autoincrement())
  consumer_id Int     @unique
  is_enabled  Boolean @default(true)

  points_per_currency     Decimal  @default(1) @db.Decimal(10, 2)
  minimum_purchase_amount Decimal  @default(0) @db.Decimal(10, 2)
  maximum_points_per_sale Decimal? @db.Decimal(10, 2)

  redemption_value   Decimal @default(0.01) @db.Decimal(10, 4)
  minimum_redemption Int     @default(100)
  maximum_redemption Int?

  points_expire_days Int?

  allow_partial_redemption Boolean @default(true)
  earn_on_sale_only        Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  consumer Consumer @relation(fields: [consumer_id], references: [id], onDelete: Cascade)

  @@map("rewards_settings")
}

model CustomerRewardsPoints {
  id                Int       @id @default(autoincrement())
  customer_id       Int       @unique
  consumer_id       Int
  total_points      Int       @default(0)
  lifetime_earned   Int       @default(0)
  lifetime_redeemed Int       @default(0)
  last_earned_at    DateTime?
  last_redeemed_at  DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  consumer Consumer @relation(fields: [consumer_id], references: [id], onDelete: Cascade)

  @@index([consumer_id, total_points])
  @@map("customer_rewards_points")
}

model RewardsPointTransaction {
  id                 Int                    @id @default(autoincrement())
  customer_id        Int
  consumer_id        Int
  type               RewardsTransactionType
  points             Int
  // NOTE: balance_before/balance_after kept intentionally as a snapshot for audit trail.
  // Must ALWAYS be written in the same transaction as the CustomerRewardsPoints update.
  balance_before     Int
  balance_after      Int
  sale_id            Int?
  description        String?
  reference          String?
  expiry_date        DateTime?
  created_by_user_id Int?
  notes              String?
  created_at         DateTime               @default(now())

  customer   Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  consumer   Consumer @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  sale       Sale?    @relation(fields: [sale_id], references: [id], onDelete: SetNull)
  created_by User?    @relation(fields: [created_by_user_id], references: [id], onDelete: SetNull)

  @@index([customer_id, created_at])
  @@index([consumer_id, type])
  @@index([expiry_date])
  @@map("rewards_point_transactions")
}

// ============================================
// Receipt PDF Settings
// ============================================

model ReceiptPdfSetting {
  id          Int    @id @default(autoincrement())
  consumer_id Int
  branch_id   Int? // null = consumer-level default, set = branch-specific override
  name        String // Preset display name (e.g., "Default Receipt", "Thermal Receipt")

  // Type of document this preset is for
  type String // 'receipt' | 'quotation' | 'return'

  // Only one setting can be active per scope (consumer or branch) per type
  is_active Boolean @default(false)

  // Layout settings ONLY - no branding data (that comes from Consumer/Branch tables)
  settings Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by Int?

  consumer  Consumer @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@unique([consumer_id, branch_id, name, type])
  @@index([consumer_id, branch_id, type, is_active]) // Query: active setting for branch+type
  @@index([consumer_id, type, is_active]) // Query: active consumer default for type
  @@index([branch_id])
  @@map("receipt_pdf_settings")
}

// ============================================
// ERP
// ============================================

model ERPSettings {
  id          Int @id @default(autoincrement())
  consumer_id Int @unique

  attendance_gps_enabled Boolean @default(false)
  gps_radius_meters      Int?    @default(100)

  salary_cycle       String @default("monthly")
  salary_payment_day Int?   @default(1)

  overtime_multiplier Decimal @default(1.5) @db.Decimal(5, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  consumer Consumer @relation(fields: [consumer_id], references: [id], onDelete: Cascade)

  @@map("erp_settings")
}

model SalaryStructure {
  id          Int @id @default(autoincrement())
  user_id     Int
  consumer_id Int

  basic_salary        Decimal @db.Decimal(10, 2)
  house_allowance     Decimal @default(0) @db.Decimal(10, 2)
  medical_allowance   Decimal @default(0) @db.Decimal(10, 2)
  transport_allowance Decimal @default(0) @db.Decimal(10, 2)
  food_allowance      Decimal @default(0) @db.Decimal(10, 2)
  other_allowances    Decimal @default(0) @db.Decimal(10, 2)

  overtime_hourly_rate Decimal? @db.Decimal(10, 2)

  is_active      Boolean   @default(true)
  effective_from DateTime  @default(now())
  effective_to   DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  consumer Consumer @relation(fields: [consumer_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_active])
  @@index([consumer_id])
  @@map("salary_structures")
}

model SalaryIncrement {
  id          Int @id @default(autoincrement())
  user_id     Int
  consumer_id Int

  previous_basic       Decimal  @db.Decimal(10, 2)
  new_basic            Decimal  @db.Decimal(10, 2)
  increment_amount     Decimal  @db.Decimal(10, 2)
  increment_percentage Decimal? @db.Decimal(5, 2)

  reason         String?
  notes          String?
  effective_date DateTime

  created_by_user_id Int?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user       User     @relation("EmployeeSalaryIncrements", fields: [user_id], references: [id], onDelete: Cascade)
  consumer   Consumer @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  created_by User?    @relation("SalaryIncrementCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)

  @@index([user_id, effective_date])
  @@index([consumer_id])
  @@map("salary_increments")
}

model Attendance {
  id          Int      @id @default(autoincrement())
  user_id     Int
  consumer_id Int
  date        DateTime @db.Date

  check_in_time  DateTime?
  check_out_time DateTime?

  check_in_latitude   Decimal? @db.Decimal(10, 8)
  check_in_longitude  Decimal? @db.Decimal(11, 8)
  check_out_latitude  Decimal? @db.Decimal(10, 8)
  check_out_longitude Decimal? @db.Decimal(11, 8)

  status       AttendanceStatus @default(PRESENT)
  worked_hours Decimal?         @db.Decimal(5, 2)
  notes        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  consumer Consumer @relation(fields: [consumer_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
  @@index([consumer_id, date])
  @@index([consumer_id, status])
  @@map("attendances")
}

model Leave {
  id          Int @id @default(autoincrement())
  user_id     Int
  consumer_id Int

  leave_type  String
  start_date  DateTime @db.Date
  end_date    DateTime @db.Date
  is_half_day Boolean  @default(false)
  total_days  Decimal  @db.Decimal(5, 2)

  reason String?
  status LeaveStatus @default(PENDING)

  approved_by_user_id Int?
  approved_at         DateTime?
  rejection_reason    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user        User     @relation("EmployeeLeaves", fields: [user_id], references: [id], onDelete: Cascade)
  consumer    Consumer @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  approved_by User?    @relation("LeaveApprover", fields: [approved_by_user_id], references: [id], onDelete: SetNull)

  @@index([user_id, start_date])
  @@index([consumer_id, status])
  @@index([approved_by_user_id])
  @@map("leaves")
}

model Overtime {
  id          Int      @id @default(autoincrement())
  user_id     Int
  consumer_id Int
  date        DateTime @db.Date

  hours        Decimal  @db.Decimal(5, 2)
  hourly_rate  Decimal? @db.Decimal(10, 2)
  total_amount Decimal  @db.Decimal(10, 2)

  reason String?
  status OvertimeStatus @default(PENDING)

  approved_by_user_id Int?
  approved_at         DateTime?
  rejection_reason    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user              User              @relation("EmployeeOvertimes", fields: [user_id], references: [id], onDelete: Cascade)
  consumer          Consumer          @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  approved_by       User?             @relation("OvertimeApprover", fields: [approved_by_user_id], references: [id], onDelete: SetNull)
  overtime_payments OvertimePayment[]

  @@index([user_id, date])
  @@index([consumer_id, status])
  @@map("overtimes")
}

model Expense {
  id          Int @id @default(autoincrement())
  user_id     Int
  consumer_id Int

  category          String
  amount            Decimal  @db.Decimal(10, 2)
  date              DateTime @db.Date
  description       String?
  receipt_url       String?
  include_in_salary Boolean  @default(false)

  status ExpenseStatus @default(PENDING)

  approved_by_user_id Int?
  approved_at         DateTime?
  rejection_reason    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user             User             @relation("EmployeeExpenses", fields: [user_id], references: [id], onDelete: Cascade)
  consumer         Consumer         @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  approved_by      User?            @relation("ExpenseApprover", fields: [approved_by_user_id], references: [id], onDelete: SetNull)
  expense_payments ExpensePayment[]

  @@index([user_id, date])
  @@index([consumer_id, status])
  @@index([consumer_id, include_in_salary, status])
}

model OperationalCost {
  id          Int      @id @default(autoincrement())
  consumer_id Int
  branch_id   Int?
  created_by  Int
  name        String
  amount      Decimal  @db.Decimal(12, 2)
  incurred_on DateTime @db.Date
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  consumer Consumer @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  creator  User     @relation(fields: [created_by], references: [id], onDelete: Restrict)

  @@index([consumer_id, incurred_on])
  @@index([consumer_id, branch_id, incurred_on])
  @@map("operational_costs")
}

model Deduction {
  id          Int @id @default(autoincrement())
  user_id     Int
  consumer_id Int

  type   String
  amount Decimal  @db.Decimal(10, 2)
  date   DateTime @db.Date
  reason String
  notes  String?

  status DeductionStatus @default(PENDING)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user               User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  consumer           Consumer           @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  deduction_payments DeductionPayment[]

  @@index([user_id, status])
  @@index([consumer_id, date])
  @@map("deductions")
}

model Advance {
  id          Int @id @default(autoincrement())
  user_id     Int
  consumer_id Int

  amount       Decimal  @db.Decimal(10, 2)
  request_date DateTime @db.Date
  reason       String?

  status AdvanceStatus @default(PENDING)

  approved_by_user_id Int?
  approved_at         DateTime?
  rejection_reason    String?

  paid_date DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user             User             @relation("EmployeeAdvances", fields: [user_id], references: [id], onDelete: Cascade)
  consumer         Consumer         @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  approved_by      User?            @relation("AdvanceApprover", fields: [approved_by_user_id], references: [id], onDelete: SetNull)
  advance_payments AdvancePayment[]

  @@index([user_id, status])
  @@index([consumer_id, status])
  @@map("advances")
}

model SalaryPayment {
  id          Int @id @default(autoincrement())
  user_id     Int
  consumer_id Int

  period_start DateTime @db.Date
  period_end   DateTime @db.Date

  basic_salary        Decimal @default(0) @db.Decimal(10, 2)
  house_allowance     Decimal @default(0) @db.Decimal(10, 2)
  medical_allowance   Decimal @default(0) @db.Decimal(10, 2)
  transport_allowance Decimal @default(0) @db.Decimal(10, 2)
  food_allowance      Decimal @default(0) @db.Decimal(10, 2)
  other_allowances    Decimal @default(0) @db.Decimal(10, 2)

  overtime_amount       Decimal @default(0) @db.Decimal(10, 2)
  reimbursable_expenses Decimal @default(0) @db.Decimal(10, 2)

  gross_salary     Decimal @db.Decimal(10, 2)
  total_deductions Decimal @default(0) @db.Decimal(10, 2)
  net_salary       Decimal @db.Decimal(10, 2)
  paid_amount      Decimal @db.Decimal(10, 2)

  payment_date      DateTime
  payment_method    PaymentMethodEnum
  payment_reference String?
  notes             String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user               User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  consumer           Consumer           @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  expense_payments   ExpensePayment[]
  deduction_payments DeductionPayment[]
  advance_payments   AdvancePayment[]
  overtime_payments  OvertimePayment[]

  @@index([user_id, period_start]) // Employee payslip history
  @@index([consumer_id, payment_date]) // Payroll run report for tenant
  @@map("salary_payments")
}

model ExpensePayment {
  id                Int      @id @default(autoincrement())
  salary_payment_id Int
  expense_id        Int
  amount_paid       Decimal  @db.Decimal(10, 2)
  created_at        DateTime @default(now())

  salary_payment SalaryPayment @relation(fields: [salary_payment_id], references: [id], onDelete: Cascade)
  expense        Expense       @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@unique([salary_payment_id, expense_id])
  @@index([expense_id])
  @@map("expense_payments")
}

model DeductionPayment {
  id                Int      @id @default(autoincrement())
  salary_payment_id Int
  deduction_id      Int
  amount_deducted   Decimal  @db.Decimal(10, 2)
  created_at        DateTime @default(now())

  salary_payment SalaryPayment @relation(fields: [salary_payment_id], references: [id], onDelete: Cascade)
  deduction      Deduction     @relation(fields: [deduction_id], references: [id], onDelete: Cascade)

  @@unique([salary_payment_id, deduction_id])
  @@index([deduction_id])
  @@map("deduction_payments")
}

model AdvancePayment {
  id                Int      @id @default(autoincrement())
  salary_payment_id Int
  advance_id        Int
  amount_deducted   Decimal  @db.Decimal(10, 2)
  created_at        DateTime @default(now())

  salary_payment SalaryPayment @relation(fields: [salary_payment_id], references: [id], onDelete: Cascade)
  advance        Advance       @relation(fields: [advance_id], references: [id], onDelete: Cascade)

  @@unique([salary_payment_id, advance_id])
  @@index([advance_id])
  @@map("advance_payments")
}

model OvertimePayment {
  id                Int      @id @default(autoincrement())
  salary_payment_id Int
  overtime_id       Int
  amount_paid       Decimal  @db.Decimal(10, 2)
  created_at        DateTime @default(now())

  salary_payment SalaryPayment @relation(fields: [salary_payment_id], references: [id], onDelete: Cascade)
  overtime       Overtime      @relation(fields: [overtime_id], references: [id], onDelete: Cascade)

  @@unique([salary_payment_id, overtime_id])
  @@index([overtime_id])
  @@map("overtime_payments")
}

// ============================================
// Support Tickets
// ============================================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketCategory {
  BILLING
  TECHNICAL
  FEATURE_REQUEST
  ACCOUNT
  OTHER
}

enum SupportAuthorType {
  CONSUMER
  SUPER_ADMIN
}

model SupportTicket {
  id             Int                   @id @default(autoincrement())
  consumer_id    Int
  created_by_id  Int
  assigned_to_id Int?
  subject        String
  category       SupportTicketCategory @default(OTHER)
  priority       SupportTicketPriority @default(MEDIUM)
  status         SupportTicketStatus   @default(OPEN)
  last_reply_at  DateTime              @default(now())
  closed_at      DateTime?
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt

  consumer    Consumer               @relation(fields: [consumer_id], references: [id], onDelete: Cascade)
  created_by  User                   @relation("SupportTicketCreator", fields: [created_by_id], references: [id], onDelete: Cascade)
  assigned_to SuperAdmin?            @relation("SupportTicketAssignee", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  messages    SupportTicketMessage[]

  @@index([consumer_id, status]) // Tenant ticket list
  @@index([status, last_reply_at]) // Super admin queue, newest activity first
  @@index([assigned_to_id])
  @@index([created_by_id])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id               Int               @id @default(autoincrement())
  ticket_id        Int
  author_type      SupportAuthorType
  consumer_user_id Int?
  super_admin_id   Int?
  body             String
  created_at       DateTime          @default(now())

  ticket        SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  consumer_user User?         @relation("SupportMessageConsumerAuthor", fields: [consumer_user_id], references: [id], onDelete: SetNull)
  super_admin   SuperAdmin?   @relation("SupportMessageAdminAuthor", fields: [super_admin_id], references: [id], onDelete: SetNull)

  @@index([ticket_id, created_at])
  @@index([consumer_user_id])
  @@index([super_admin_id])
  @@map("support_ticket_messages")
}

// ============================================
// Portfolio (marketing site CMS)
// ============================================

enum PortfolioLeadType {
  CONTACT
  DEMO
}

enum PortfolioLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model PortfolioSetting {
  // Single-row table; the app always reads/writes id = 1.
  id            Int      @id @default(1)
  site_name     String
  title         String
  description   String
  url           String
  og_image      String
  author        String
  contact_email String
  sales_email   String
  phone         String
  address       String?
  keywords      String[]
  updated_at    DateTime @updatedAt

  @@map("portfolio_settings")
}

model PortfolioSolution {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  subtitle     String
  icon_name    String
  badge        String
  description  String
  features     String[]
  benefits     String[]
  metric_label String
  metric_value String
  image_key    String
  sort_order   Int      @default(0)
  is_published Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([is_published, sort_order])
  @@map("portfolio_solutions")
}

model PortfolioFeature {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  category     String
  title        String
  tagline      String
  description  String
  highlights   String[]
  icon         String
  badge        String?
  sort_order   Int      @default(0)
  is_published Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([is_published, sort_order])
  @@map("portfolio_features")
}

model PortfolioPricingPlan {
  id                   Int      @id @default(autoincrement())
  slug                 String   @unique
  name                 String
  badge                String?
  description          String
  price_monthly        Decimal  @db.Decimal(10, 2)
  price_annual_monthly Decimal  @db.Decimal(10, 2)
  is_popular           Boolean  @default(false)
  features             String[]
  not_included         String[]
  cta                  String
  sort_order           Int      @default(0)
  is_published         Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([is_published, sort_order])
  @@map("portfolio_pricing_plans")
}

model PortfolioFaq {
  id           Int      @id @default(autoincrement())
  question     String
  answer       String
  aeo_summary  String
  category     String
  sort_order   Int      @default(0)
  is_published Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([is_published, sort_order])
  @@map("portfolio_faqs")
}

model PortfolioTestimonial {
  id           Int      @id @default(autoincrement())
  quote        String
  author       String
  role         String
  company      String
  rating       Int      @default(5)
  metrics      String?
  sort_order   Int      @default(0)
  is_published Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([is_published, sort_order])
  @@map("portfolio_testimonials")
}

model PortfolioDemoProduct {
  id              Int      @id @default(autoincrement())
  name            String
  sku             String   @unique
  price           Decimal  @db.Decimal(10, 2)
  wholesale_price Decimal  @db.Decimal(10, 2)
  category        String
  image           String
  tax             Decimal  @default(0) @db.Decimal(5, 4)
  serial          String?
  sort_order      Int      @default(0)
  is_published    Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([is_published, sort_order])
  @@map("portfolio_demo_products")
}

model PortfolioLead {
  id            Int                 @id @default(autoincrement())
  type          PortfolioLeadType
  status        PortfolioLeadStatus @default(NEW)
  name          String
  email         String
  phone         String?
  business_name String?
  industry      String?
  locations     String?
  message       String?
  source_page   String?
  notes         String?
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt

  @@index([status, created_at])
  @@index([type, created_at])
  @@index([email])
  @@map("portfolio_leads")
}
