# ===================================================================
# Backend Docker Environment Configuration
# ===================================================================
# Copy this file to .env.docker
# The root .env.docker file contains infrastructure config
# This file contains backend-specific configuration
# ===================================================================

# Server Configuration
NODE_ENV=production
PORT=8000

# Database Configuration (uses Docker service names)
DB_HOST=postgres
DB_NAME=posbuzz
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# Redis Configuration (uses Docker service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PREFIX=posbuzz
REDIS_PASSWORD=
CACHE_TTL=3600

# JWT Configuration (should match root .env.docker)
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=655a41e13d92ebe879e8fae73a575c1e25eb8cc1e4ddf78f6a19f91cdfb78
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

CSRF_SECRET_KEY=51c2be361566806a9a224805e32ed647

# CORS Configuration
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173,https://posbuzz.com,https://posbuzz.xyz,https://posbuzz.cloud,https://*.posbuzz.xyz,https://*.posbuzz.cloud,https://*.posbuzz.com,http://*.localhost:3000,http://*.localhost:5173,http://*.localhost:3001

# RabbitMQ Configuration (uses Docker service name)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# AI Service URL (uses Docker service name)
FASTAPI_URL=http://ai-service:8001/api/v1

# Portfolio publish hook (optional). When the secret is empty the marketing
# site just refreshes on its own ISR schedule.
PORTFOLIO_REVALIDATE_URL=http://portfolio:3000/api/revalidate
PORTFOLIO_REVALIDATE_SECRET=2fbe835601edba3534e25d74c98e063fbd7a8fdf02ea5e0fe6336fd97d7c3103

# PostgreSQL Binaries (installed in Docker container)
PG_DUMP_PATH=pg_dump
PSQL_PATH=psql

# ===================================================================
# Notes:
# - Uses Docker service names (postgres, redis, rabbitmq, ai-service)
# - For production, update passwords and secrets
# - CORS_ORIGINS should match your actual domains
# ===================================================================
