# ===================================================================
# Backend Docker Environment Configuration
# ===================================================================
# Copy this file to .env.docker
# The root .env.docker file contains infrastructure config
# This file contains backend-specific configuration
# ===================================================================

# Server Configuration
NODE_ENV=production
PORT=8000

# Database Configuration (uses Docker service names)
DB_HOST=postgres
DB_NAME=posbuzz
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/posbuzz?schema=public

# Redis Configuration (uses Docker service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PREFIX=posbuzz
REDIS_PASSWORD=
CACHE_TTL=3600

# JWT Configuration (should match root .env.docker)
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=REDACTED_SECRET
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS Configuration
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# RabbitMQ Configuration (uses Docker service name)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# AI Service URL (uses Docker service name)
FASTAPI_URL=http://ai-service:8001/api/v1

# PostgreSQL Binaries (installed in Docker container)
PG_DUMP_PATH=pg_dump
PSQL_PATH=psql

# ===================================================================
# Notes:
# - Uses Docker service names (postgres, redis, rabbitmq, ai-service)
# - For production, update passwords and secrets
# - CORS_ORIGINS should match your actual domains
# ===================================================================
