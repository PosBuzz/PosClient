{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "seed:portfolio": "tsx prisma/seed-portfolio-only.ts",
    "test": "TZ=UTC jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "TZ=UTC jest --config ./test/jest-e2e.json",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" prisma-client-exception --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:int": "TZ=UTC jest --config ./test/jest-integration.json",
    "test:infra": "TZ=UTC jest --config ./test/jest-optional-infra.json",
    "test:all": "npm test -- --runInBand && npm run test:int && npm run test:e2e",
    "test:int:tz": "TZ=Asia/Dhaka jest --config ./test/jest-integration.json test/integration/reports"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.6.0",
    "@types/pdfkit": "^0.13.9",
    "amqplib": "^0.10.8",
    "bcryptjs": "^3.0.2",
    "bwip-js": "^4.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "nest-cache-redis": "^1.0.0",
    "node-thermal-printer": "^4.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "serialport": "^13.0.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.10.7",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/amqplib": "^0.10.8",
    "@types/bwip-js": "^3.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "cookie": "^1.1.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fast-check": "^4.10.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^6.6.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1",
      "^prisma-client-exception/(.*)$": "<rootDir>/prisma-client-exception/$1"
    },
    "collectCoverageFrom": [
      "src/consumer/promotions/promotion-math.ts",
      "src/consumer/inventory/utils/validate-purchase.util.ts",
      "src/consumer/inventory/utils/batch-location.util.ts",
      "src/common/services/subdomain-util.service.ts",
      "src/common/utils/error.util.ts",
      "prisma-client-exception/**/*.ts",
      "!prisma-client-exception/**/*.spec.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "reflect-metadata"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/prisma-client-exception"
    ],
    "coverageThreshold": {
      "./src/consumer/promotions/promotion-math.ts": {
        "branches": 100,
        "lines": 100
      },
      "./src/consumer/inventory/utils/validate-purchase.util.ts": {
        "branches": 100,
        "lines": 100
      },
      "./src/consumer/inventory/utils/batch-location.util.ts": {
        "branches": 100,
        "lines": 100
      },
      "./src/common/services/subdomain-util.service.ts": {
        "branches": 95,
        "lines": 95
      },
      "./prisma-client-exception/": {
        "branches": 100,
        "lines": 100
      }
    }
  },
  "overrides": {
    "uuid": "$uuid"
  },
  "engines": {
    "node": ">=22.22.1 <23"
  }
}
