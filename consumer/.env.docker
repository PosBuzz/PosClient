# ===================================================================
# Consumer Frontend Docker Environment Configuration
# ===================================================================
# Copy this file to .env.docker
# This file contains consumer frontend-specific configuration
# ===================================================================

# Build-time Environment Variables
# These are used during the Docker build process

# API URL for the backend (uses localhost for external access)
VITE_API_BASE_URL=https://api.posbuzz.cloud/api/v1

VITE_CLOUD_NAME=ddluuftiq   
VITE_UPLOAD_PRESET=test-preset
VITE_CLOUDINARY_API="https://api.cloudinary.com/v1_1/${VITE_CLOUD_NAME}/image/upload"

# ===================================================================
# Notes:
# - VITE_ variables are embedded into the build at build time
# - Use localhost:8000 for external access to backend from browser
# - For production, set to your actual domain:
#   VITE_API_BASE_URL=https://api.yourdomain.com
# ===================================================================
