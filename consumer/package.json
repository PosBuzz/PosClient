{
  "name": "consumer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "preview": "vite preview",
    "tsc": "tsc -b",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal public/posbuzz.svg",
    "lint:check": "eslint . --max-warnings=0",
    "typecheck": "node ../scripts/contracts/generate-response-types.mjs --check --app consumer && tsc -b",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "test:cov": "TZ=UTC vitest run --coverage",
    "test:mutation": "node scripts/mutation.mjs"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@dr.pogodin/react-helmet": "^3.0.1",
    "@tailwindcss/vite": "^4.1.3",
    "@tanstack/react-query": "^5.72.1",
    "@types/file-saver": "^2.0.7",
    "antd": "^5.24.6",
    "axios": "^1.8.4",
    "cloudinary": "^2.6.1",
    "dayjs": "^1.11.13",
    "file-saver": "^2.0.5",
    "lodash": "^4.17.21",
    "react": "^19.0.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.0",
    "recharts": "^3.1.0",
    "tailwindcss": "^4.1.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash": "^4.17.16",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.22.1 <23"
  }
}
