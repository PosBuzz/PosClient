# ===================================================================
# Docker Compose Environment Configuration (Infrastructure Only)
# ===================================================================
# Copy this file to .env.docker and update with your values
# This file contains ONLY infrastructure and shared configuration
# Each service has its own .env.docker.example in its directory
# ===================================================================

# ===================================================================
# INFRASTRUCTURE SERVICES (PostgreSQL, Redis, RabbitMQ, Ollama)
# ===================================================================

# PostgreSQL Configuration
DB_HOST=postgres
DB_NAME=posbuzz
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ===================================================================
# SHARED SECURITY CONFIGURATION
# ===================================================================

# JWT Configuration (REQUIRED - Change for production!)
JWT_SECRET_KEY=655a41e13d92ebe879e8fae73a575c1e25eb8cc1e4ddf78f6a19f91cdfb78
JWT_ALGORITHM=HS256

# ===================================================================
# SERVICE PORTS (for docker-compose port mapping)
# ===================================================================

BACKEND_PORT=8000
AI_SERVICE_PORT=8001
ADMIN_PORT=3001
CONSUMER_PORT=3000

# ===================================================================
# IMPORTANT NOTES
# ===================================================================
# 1. This file contains ONLY infrastructure and shared config
# 
# 2. Each service has its own .env.docker.example:
#    - backend/.env.docker.example
#    - ai-service/.env.docker.example
#    - admin/.env.docker.example
#    - consumer/.env.docker.example
#
# 3. For production:
#    - Change JWT_SECRET_KEY to a strong random string
#    - Change DB_PASSWORD to a secure password
#    - Consider setting REDIS_PASSWORD
#    - Update RABBITMQ_USER and RABBITMQ_PASSWORD
#
# 4. To use:
#    cp .env.docker.example .env.docker
#    cp backend/.env.docker.example backend/.env.docker
#    cp ai-service/.env.docker.example ai-service/.env.docker
#    docker-compose up -d
# ===================================================================

# Portfolio marketing site
BACKEND_API_URL=http://backend:8000/api/v1
CMS_REVALIDATE_SECONDS=300
# Shared secret for the CMS publish hook. Set the same value on the backend
# (PORTFOLIO_REVALIDATE_SECRET) and the portfolio app (REVALIDATE_SECRET).
PORTFOLIO_REVALIDATE_SECRET=
