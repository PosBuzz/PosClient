# Backend API the marketing site reads its CMS content from and posts leads to.
# Server-side only — never exposed to the browser.
BACKEND_API_URL=http://localhost:8000/api/v1

# How long (seconds) a rendered page may serve cached CMS content before it
# revalidates against the backend. Defaults to 300.
CMS_REVALIDATE_SECONDS=3600

# Shared secret for the publish hook the backend calls after a CMS edit
# (POST /api/revalidate). Leave unset to disable the hook — the site then only
# refreshes on the CMS_REVALIDATE_SECONDS schedule above.
REVALIDATE_SECRET=change-me
