# ===================================================================
# Portfolio (Next.js marketing site) Docker Environment Configuration
# ===================================================================
# Copy this file to .env.docker
# The root .env.docker file contains infrastructure config
# ===================================================================

# Backend API the site reads CMS content from and posts leads to.
# Server-side only — never exposed to the browser.
BACKEND_API_URL=http://backend:8000/api/v1

# How long (seconds) a rendered page may serve cached CMS content before it
# revalidates. The publish hook below bypasses this on edit.
CMS_REVALIDATE_SECONDS=300

# Shared secret for the publish hook the backend calls after a CMS edit.
# Must match PORTFOLIO_REVALIDATE_SECRET in backend/.env.docker.
# Empty = hook disabled; the site then refreshes on the schedule above.
REVALIDATE_SECRET=

# ===================================================================
# Notes:
# - Uses Docker service names (backend)
# - BACKEND_API_URL is also passed as a build arg so pages can be prerendered
#   against live CMS content when the backend is reachable at build time
# ===================================================================
