# App settings
APP_NAME="AI Service"
ENVIRONMENT="development"
PORT=8001
DEBUG=False

# JWT settings
JWT_SECRET="REDACTED_SECRET"
JWT_ALGORITHM="HS256"

# RabbitMQ settings
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"

# Redis settings
CACHE_REDIS_ENABLED=True
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CACHE_TTL=86400
REDIS_PASSWORD=

# Search service selection (google, duckduckgo, or mock)
SEARCH_ENGINE="duckduckgo"

# Google Search Console settings
GOOGLE_SEARCH_API_KEY="REDACTED_SECRET"
GOOGLE_SEARCH_CX="b37c020745ae44d8a"

# ChromaDB settings
CHROMA_DB_DIR=./data/chroma_db
CHROMA_TELEMETRY=False
CHROMA_COLLECTION_SHARDING=True

# Performance settings
MAX_BACKGROUND_BATCH_SIZE="5"
FEEDBACK_MAX_FILES=10000

# Optimization settings
VECTOR_STORE_CACHE_TTL=3600
BACKGROUND_LEARNING_INTERVAL=43200

# Feedback settings
FEEDBACK_CACHE_TTL=3600
FEEDBACK_ANALYSIS_INTERVAL=86400
FEEDBACK_CLEANUP_INTERVAL=604800
FEEDBACK_QUALITY_THRESHOLD=4

# History settings
HISTORY_CLEANUP_INTERVAL=604800
HISTORY_VERSIONS_TO_KEEP=3

# LLM settings
OLLAMA_BASE_URL="http://localhost:11434"
LLM_MODEL="llama3:8b-instruct-q8_0"
LLM_TEMPERATURE=0.1
LLM_NUM_GPU=0
LLM_NUM_CTX=512
LLM_NUM_THREAD=8
LLM_REPEAT_PENALTY=1.1

# Vector embedding settings
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
USE_GPU=False