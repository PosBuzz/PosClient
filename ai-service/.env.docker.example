# ===================================================================
# AI Service Docker Environment Configuration
# ===================================================================
# Copy this file to .env.docker
# The root .env.docker file contains infrastructure config
# This file contains AI service-specific configuration
# ===================================================================

# App Settings
APP_NAME="AI Service"
ENVIRONMENT=production
PORT=8001
DEBUG=False

# JWT Settings (should match root .env.docker)
JWT_SECRET=REDACTED_SECRET
JWT_ALGORITHM=HS256

# RabbitMQ Configuration (uses Docker service name)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Redis Configuration (uses Docker service name)
CACHE_REDIS_ENABLED=True
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL=86400
REDIS_PASSWORD=

# Search Engine Configuration
SEARCH_ENGINE=duckduckgo
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ChromaDB Configuration
CHROMA_DB_DIR=./data/chroma_db
CHROMA_TELEMETRY=False
CHROMA_COLLECTION_SHARDING=True

# Performance Settings
MAX_BACKGROUND_BATCH_SIZE=5
FEEDBACK_MAX_FILES=10000

# Optimization Settings
VECTOR_STORE_CACHE_TTL=3600
BACKGROUND_LEARNING_INTERVAL=43200

# Feedback Settings
FEEDBACK_CACHE_TTL=3600
FEEDBACK_ANALYSIS_INTERVAL=86400
FEEDBACK_CLEANUP_INTERVAL=604800
FEEDBACK_QUALITY_THRESHOLD=4

# History Settings
HISTORY_CLEANUP_INTERVAL=604800
HISTORY_VERSIONS_TO_KEEP=3

# Ollama LLM Configuration (uses Docker service name)
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=llama3:8b-instruct-q8_0
LLM_TEMPERATURE=0.1
LLM_NUM_GPU=0
LLM_NUM_CTX=512
LLM_NUM_THREAD=8
LLM_REPEAT_PENALTY=1.1

# Embedding Model Configuration (HuggingFace)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
USE_GPU=False

# HuggingFace Cache Paths (set by Dockerfile)
HF_HOME=/app/.cache/huggingface
TRANSFORMERS_CACHE=/app/.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/app/.cache/huggingface

# ===================================================================
# Notes:
# - Uses Docker service names (redis, rabbitmq, ollama)
# - Embedding model (BAAI/bge-small-en-v1.5) downloads automatically on first startup (~90MB)
# - Ollama model pulls automatically on first startup (~4.5GB for llama3:8b-instruct-q8_0)
# - Models are cached in Docker volumes and persist across restarts
# ===================================================================
