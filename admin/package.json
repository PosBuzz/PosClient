    "@tanstack/react-query": "^5.72.1",
    "antd": "^5.24.6",
    "axios": "^1.8.4",
    "dayjs": "^1.11.13",
    "file-saver": "^2.0.5",
    "lodash": "^4.17.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.0",
    "tailwindcss": "^4.1.3",
    "use-debounce": "^10.0.4",
    "zustand": "^5.0.3"
